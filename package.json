{
	"name": "ai--test--q",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:push": "drizzle-kit push --force",
		"db:generate": "drizzle-kit generate",
		"db:seed": "tsx scripts/seed.ts && tsx scripts/export-seed-sql.ts",
		"db:setup": "npm run db:push && npm run db:seed && npm run d1:migrate:local && npm run d1:seed:local",
		"db:studio": "drizzle-kit studio",
		"d1:migrate:local": "wrangler d1 migrations apply boq-db --local",
		"d1:seed:local": "wrangler d1 execute boq-db --local --file data/seed.sql",
		"d1:migrate:remote": "wrangler d1 migrations apply boq-db --remote",
		"d1:seed:remote": "wrangler d1 execute boq-db --remote --file data/seed.sql"
	},
	"devDependencies": {
		"@internationalized/date": "^3.12.4",
		"@libsql/client": "^0.18.0",
		"@lucide/svelte": "^1.64.0",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"bits-ui": "^2.20.2",
		"drizzle-kit": "^0.31.11",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.23.15",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"wrangler": "^4.156.0",
		"xlsx": "^0.18.5"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.4",
		"tailwind-merge": "^3.7.0"
	}
}
